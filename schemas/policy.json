{
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string",
          "enum": ["off", "auto", "required"]
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallel": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "version": {
      "type": "integer"
    },
    "default_lane": {
      "type": "string",
      "enum": [
        "engineering",
        "product",
        "marketing",
        "sales",
        "platform",
        "security"
      ]
    },
    "retries": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer"
        }
      }
    },
    "commit_transcripts": {
      "type": "boolean"
    },
    "lanes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tiers_default": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approvers": {
            "type": "integer"
          },
          "cross_family": {
            "type": "boolean"
          },
          "min_confidence_to_sign": {
            "type": "string",
            "enum": [
              "opinion",
              "anecdote",
              "data",
              "test"
            ]
          },
          "by_risk": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tiers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "approvers": {
                  "type": "integer"
                },
                "auto_accept": {
                  "type": "boolean"
                },
                "min_confidence_to_sign": {
                  "type": "string",
                  "enum": [
                    "opinion",
                    "anecdote",
                    "data",
                    "test"
                  ]
                },
                "human_ack_before_build": {
                  "type": "boolean"
                },
                "require_numbers": {
                  "type": "boolean"
                }
              }
            }
          },
          "require_numbers": {
            "type": "boolean"
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "fallback": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/route"
          }
        },
        "seats": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "swarm": {
      "type": "object",
      "properties": {
        "parallel": {
          "type": "integer"
        },
        "default_n": {
          "type": "integer"
        },
        "max_n": {
          "type": "integer"
        }
      }
    },
    "sizes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "floor_risk": {
          "type": "string",
          "enum": [
            "none",
            "ux",
            "data",
            "infra",
            "security",
            "money"
          ]
        },
        "small": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "harden": {
              "type": "boolean"
            },
            "skip_tiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "medium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "harden": {
              "type": "boolean"
            },
            "skip_tiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "large": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "harden": {
              "type": "boolean"
            },
            "skip_tiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "humans_only": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "question",
              "sign",
              "approve_design",
              "ack_risk",
              "accept",
              "unblock",
              "confidence",
              "governance"
            ]
          }
        },
        "relay": {
          "type": "boolean"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_override": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        }
      }
    }
  }
}
