{
  "type": "object",
  "required": ["task", "claims", "files_changed"],
  "properties": {
    "task": { "type": "string" },
    "claims": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["text", "proof_cmd", "proof_output"], "properties": { "text": { "type": "string" }, "proof_cmd": { "type": "string" }, "proof_output": { "type": "string" } } } },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "dispositions": { "type": "array", "items": { "type": "object", "required": ["finding", "disposition", "evidence"], "properties": { "finding": { "type": "string" }, "disposition": { "type": "string", "enum": ["reproduced", "not_reproduced"] }, "evidence": { "type": "string" } } } },
    "notes": { "type": "string" }
  }
}
